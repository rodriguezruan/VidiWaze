#include <WiFi.h>
#include <HTTPClient.h>
#include <LiquidCrystal.h>
#include <vector>

// ── Configuração (não suba este arquivo com senha para o GitHub) ─────────────
const char* ssid            = "WLL-Inatel";
const char* password        = "inatelsemfio";
const char* googleScriptUrl = "https://script.google.com/macros/s/AKfycbyxF1hc8aXIXojRj49McqN21UyscO-y_8C1na94D8BhOUTSYUoy8TubGdj1meEisce1YA/exec";

// ── LCD em modo paralelo: RS, E, D4, D5, D6, D7 ──────────────────────────────
LiquidCrystal lcd(19, 23, 18, 17, 16, 15);

// ── Botões (INPUT_PULLUP: ligar entre o pino e o GND) ────────────────────────
const int NEXT_BTN    = 14;   // troca de ponto e pausa a coleta
const int CONFIRM_BTN = 27;   // inicia / pausa a coleta

// ── Pontos de coleta ─────────────────────────────────────────────────────────
const char* POINTS[] = { "eHealth_p01", "eHealth_p02", "eHealth_p03", "eHealth_p04", "eHealth_p05" };
const int NUM_POINTS = sizeof(POINTS) / sizeof(POINTS[0]);

// ── Tempos ───────────────────────────────────────────────────────────────────
const unsigned long CONNECT_TIMEOUT    = 15000;
const unsigned long RECONNECT_INTERVAL = 5000;
const unsigned long SCAN_INTERVAL      = 2000;   // ms entre scans
const unsigned long DEBOUNCE_MS        = 50;

// ── Estado ───────────────────────────────────────────────────────────────────
int    pointIndex   = 0;
bool   collecting   = false;
String sessao       = "s1";        // troque pelo Serial: SESSAO <nome>
unsigned long sampleId      = 0;   // contador global (vai para o Sheets)
unsigned long samplesPoint  = 0;   // amostras do ponto atual nesta sessão
int    lastApsFound = 0;
String lastStatus   = "";

unsigned long lastReconnectAttempt = 0;
unsigned long lastScan = 0;

// ─────────────────────────────────────────────────────────────────────────────
// LCD
// ─────────────────────────────────────────────────────────────────────────────
void lcdLine(int row, String text) {
  while (text.length() < 16) text += ' ';   // limpa sobras da linha anterior
  lcd.setCursor(0, row);
  lcd.print(text.substring(0, 16));
}

void showStatus() {
  lcdLine(0, POINTS[pointIndex]);
  if (WiFi.status() != WL_CONNECTED) {
    lcdLine(1, "Sem Wi-Fi...");
  } else if (!collecting) {
    lcdLine(1, "Pausado n=" + String(samplesPoint));
  } else {
    lcdLine(1, "n=" + String(samplesPoint) + " AP=" + String(lastApsFound) + " " + lastStatus);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Wi-Fi
// ─────────────────────────────────────────────────────────────────────────────
bool connectWiFi() {
  lcdLine(1, "Conectando...");
  Serial.print("Conectando");
  WiFi.begin(ssid, password);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < CONNECT_TIMEOUT) {
    delay(300);
    Serial.print(".");
  }
  bool ok = WiFi.status() == WL_CONNECTED;
  Serial.println(ok ? "\nConectado! IP: " + WiFi.localIP().toString() : "\nFalha ao conectar.");
  showStatus();
  return ok;
}

void maybeReconnect() {
  if (WiFi.status() == WL_CONNECTED) return;
  if (millis() - lastReconnectAttempt < RECONNECT_INTERVAL) return;
  lastReconnectAttempt = millis();
  WiFi.disconnect();
  connectWiFi();
}

// ─────────────────────────────────────────────────────────────────────────────
// Controle de ponto e coleta
// ─────────────────────────────────────────────────────────────────────────────
void nextPoint() {
  collecting   = false;
  pointIndex   = (pointIndex + 1) % NUM_POINTS;
  samplesPoint = 0;
  Serial.println("[PONTO] " + String(POINTS[pointIndex]) + " (pausado)");
  showStatus();
}

void toggleCollecting() {
  collecting = !collecting;
  lastStatus = "";
  Serial.println(collecting ? "[COLETANDO] " + String(POINTS[pointIndex]) : "[PAUSADO]");
  showStatus();
}

// Detecta só a borda de descida (aperto), não repete enquanto o botão está pressionado
bool pressed(int pin, int &lastState, unsigned long &lastChange) {
  int s = digitalRead(pin);
  if (s != lastState && millis() - lastChange > DEBOUNCE_MS) {
    lastChange = millis();
    lastState  = s;
    return s == LOW;
  }
  return false;
}

int nextState = HIGH, confirmState = HIGH;
unsigned long nextChange = 0, confirmChange = 0;

void handleButtons() {
  if (pressed(NEXT_BTN, nextState, nextChange))       nextPoint();
  if (pressed(CONFIRM_BTN, confirmState, confirmChange)) toggleCollecting();
}

// Comandos pelo Serial: NEXT | OK | SESSAO <nome> | STATUS
void handleSerial() {
  if (!Serial.available()) return;
  String cmd = Serial.readStringUntil('\n');
  cmd.trim();
  if (cmd == "NEXT") nextPoint();
  else if (cmd == "OK") toggleCollecting();
  else if (cmd.startsWith("SESSAO ")) {
    sessao = cmd.substring(7);
    sessao.trim();
    samplesPoint = 0;
    Serial.println("[SESSAO] " + sessao);
  } else if (cmd == "STATUS") {
    Serial.println("[STATUS] ponto=" + String(POINTS[pointIndex]) + " sessao=" + sessao +
                   " coletando=" + String(collecting ? "SIM" : "NAO") +
                   " n=" + String(samplesPoint) + " sample_id=" + String(sampleId));
  } else if (cmd.length() > 0) {
    Serial.println("Comandos: NEXT | OK | SESSAO <nome> | STATUS");
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Google Sheets
// ─────────────────────────────────────────────────────────────────────────────
bool sendToSheets(const std::vector<String>& rows) {
  if (rows.empty() || WiFi.status() != WL_CONNECTED) return false;

  String json = "{\"data\":[";
  for (size_t i = 0; i < rows.size(); i++) {
    if (i > 0) json += ",";
    json += rows[i];
  }
  json += "]}";

  HTTPClient http;
  // O Apps Script grava os dados ANTES de responder com 302; não seguimos o redirect.
  http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);
  http.begin(googleScriptUrl);
  http.addHeader("Content-Type", "application/json");
  int code = http.POST(json);
  http.end();

  Serial.println("[SHEETS] HTTP " + String(code));
  return code == 200 || code == 302;
}

// ─────────────────────────────────────────────────────────────────────────────
// Scan
// ─────────────────────────────────────────────────────────────────────────────
void scanAndSend() {
  int n = WiFi.scanNetworks(false, true);
  std::vector<String> rows;

  for (int i = 0; i < n; i++) {
    if (WiFi.SSID(i) != ssid) continue;
    // colunas: label, ssid, bssid, rssi_dbm, sample_id, sessao
    String row = "[\"" + String(POINTS[pointIndex]) + "\",\"" + ssid + "\",\"" +
                 WiFi.BSSIDstr(i) + "\",\"" + String(WiFi.RSSI(i)) + "\",\"" +
                 String(sampleId) + "\",\"" + sessao + "\"]";
    rows.push_back(row);
  }
  WiFi.scanDelete();

  lastApsFound = rows.size();
  bool ok = sendToSheets(rows);
  lastStatus = ok ? "OK" : "ERRO";
  if (ok) {
    sampleId++;
    samplesPoint++;
  }
  Serial.println("[SCAN] " + String(POINTS[pointIndex]) + " APs=" + String(lastApsFound) +
                 " n=" + String(samplesPoint) + " " + lastStatus);
  showStatus();
}

// ─────────────────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(NEXT_BTN, INPUT_PULLUP);
  pinMode(CONFIRM_BTN, INPUT_PULLUP);

  lcd.begin(16, 2);
  lcdLine(0, "VidiWaze coleta");
  lcdLine(1, "Iniciando...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  connectWiFi();

  Serial.println("Pronto. Botoes: NEXT (14) / CONFIRM (27). Serial: NEXT | OK | SESSAO <nome> | STATUS");
}

void loop() {
  handleButtons();
  handleSerial();
  maybeReconnect();

  if (collecting && WiFi.status() == WL_CONNECTED && millis() - lastScan >= SCAN_INTERVAL) {
    lastScan = millis();
    scanAndSend();
  }
}
